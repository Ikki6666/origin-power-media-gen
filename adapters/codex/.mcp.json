{
  "mcpServers": {
    "origin_power_media_gen": {
      "command": "npx",
      "args": ["-y", "origin-power-media-gen-mcp"],
      "enabled": true,
      "env_vars": ["MEDIA_GEN_API_KEY", "MEDIA_GEN_BASE_URL", "MEDIA_GEN_MEDIA_DIR", "MEDIA_GEN_MODELS", "YUANLI_API_KEY", "YUANLI_BASE_URL", "YUANLI_MEDIA_DIR", "YUANLI_MODELS", "AGW_API_KEY", "HOME", "PATH"],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 1800
    }
  }
}
